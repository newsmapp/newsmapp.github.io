# dependencies
node_modules/

# build output
dist/
dist-*/
.astro/
.turbo/
coverage/
playwright-report/
test-results/
.lighthouseci/

# local data and reports
reports/
*.local.*
.env
# leftover local secrets of the old Cloudflare setup; never commit them
.dev.vars
.env.*

# os / editors
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/


# AI agent config and state stay local (see privacy skill §3)
CLAUDE.md
.claude/
.cursor/
.aider*

# local databases, dumps and keys
*.sqlite
*.sqlite3
*.db
*.pem
*.key
*.p12
*.tsbuildinfo
.eslintcache
.cache/
notes/

# generated at build/typecheck time
src/generated/

# generated at build time (pnpm catalog:build): monograms and flags. Downloaded favicons
# (public/icons/*.webp, pnpm catalog:icons) are committed, so deploys have them.
public/icons/*.svg
public/flags/

# Chrome temp profiles that Lighthouse leaves behind when run under WSL
/C:*

# product spec stays local
SPEC.md
resume.md
