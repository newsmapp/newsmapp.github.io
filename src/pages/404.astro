---
import BaseLayout from '../layouts/BaseLayout.astro';
import { UI_TEXT } from '../lib/i18n/ui';
import { LANG_META, localizePath } from '../lib/i18n/lang';
import { siteLangs } from '../data/i18n';

// One file answers every missing address, so the message is given in each site language.
const [first, ...others] = siteLangs.map((lang) => ({ lang, t: UI_TEXT[lang].notFound }));
---

<BaseLayout title={first?.t.title ?? ''} description={first?.t.description ?? ''} noindex>
  <div class="page missing">
    {first && (
      <>
        <h1>{first.t.heading}</h1>
        <p>
          {first.t.body} <a href={localizePath('/', first.lang)}>{first.t.home}</a>.
        </p>
      </>
    )}
    {others.map(({ lang, t }) => (
      <div lang={LANG_META[lang].tag}>
        <h2>{t.heading}</h2>
        <p>
          {t.body} <a href={localizePath('/', lang)}>{t.home}</a>.
        </p>
      </div>
    ))}
    <button type="button" data-open-search>
      {first?.t.search}
    </button>
  </div>
</BaseLayout>

<style>
  .missing {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    padding-block: var(--space-8);
  }

  .missing div {
    display: grid;
    gap: var(--space-2);
  }

  button {
    justify-self: start;
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: var(--line) solid var(--edge);
    background: var(--accent);
    box-shadow: var(--shadow-hard);
    color: var(--on-accent);
    font: inherit;
    font-weight: var(--weight-strong);
    cursor: pointer;
  }
</style>
