---
import BaseLayout from '../layouts/BaseLayout.astro';
import CountryBox from '../components/CountryBox.astro';
import Icon from '../components/Icon.astro';
import { CONTINENT_LABELS, countries, hubs, paths } from '../data/catalog';
import { CONTINENTS } from '../schemas/common';
import { CATEGORIES } from '../schemas/catalog.schema';
import { CATEGORY_ICON, CATEGORY_SHORT, plural } from '../lib/format';
import type { IconName } from '../components/Icon.astro';
import { organization, website } from '../lib/seo/jsonld';

const siteUrl = (Astro.site ?? new URL('https://newsmap.example')).toString();
const outletCount = countries.reduce((n, c) => n + c.outlets.length, 0);
// Primary continent only, so transcontinental countries are listed once.
const groups = CONTINENTS.map((continent) => ({
  continent,
  countries: countries.filter((c) => c.continent === continent),
})).filter((g) => g.countries.length > 0);
// Topics any published country covers, with how many outlets each has across the catalog.
const topics = CATEGORIES.map((category) => ({
  category,
  count: countries.reduce(
    (n, c) => n + c.outlets.filter((o) => o.categories.includes(category)).length,
    0,
  ),
})).filter((t) => t.count > 0);
const description =
  countries.length > 0
    ? `${outletCount} newspapers, broadcasters and news sites from ${countries.length} countries, ranked by editors. Paywall and owner are marked on every outlet.`
    : 'A directory of newspapers, broadcasters and news sites by country, sorted by topic, with paywall and ownership shown for each outlet.';
---

<BaseLayout
  title="Newspapers and news sites by country, ranked by editors"
  description={description}
  jsonld={[website(siteUrl), organization(siteUrl)]}
  prose={false}
>
  <div class="page">
    <section class="intro">
      <h1>Pick a country. Read its press.</h1>
      <p class="lede">
        {countries.length > 0
          ? `${plural(outletCount, 'newspaper, broadcaster and news site', 'newspapers, broadcasters and news sites')} from ${plural(countries.length, 'country', 'countries')}, ranked by our editors. Paywall and owner are marked on every one.`
          : 'Country pages are being reviewed and will appear here once their outlets are verified.'}
      </p>
      <button class="find" type="button" data-open-search>
        <Icon name="search" size={18} />
        <span>Find a country or outlet</span>
        <kbd class="data">⌘&nbsp;K</kbd>
      </button>
      {topics.length > 1 && (
        <div class="topics" role="group" aria-label="Show outlets by topic" data-topics>
          <button type="button" aria-pressed="true" data-topic="all">
            <Icon name="list" size={16} />
            All topics
          </button>
          {topics.map((t) => (
            <button type="button" aria-pressed="false" data-topic={t.category}>
              <Icon name={CATEGORY_ICON[t.category] as IconName} size={16} />
              {CATEGORY_SHORT[t.category]}
              <span class="data">{t.count}</span>
            </button>
          ))}
        </div>
      )}
      {groups.length > 1 && (
        <nav class="jump" aria-label="Continents">
          <ul>
            {groups.map((group) => (
              <li>
                <a href={`#c-${group.continent}`}>
                  {CONTINENT_LABELS[group.continent]}
                  <span class="data">{group.countries.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </section>

    {groups.map((group, index) => (
      <section class="continent" data-continent aria-labelledby={`c-${group.continent}`}>
        <h2 id={`c-${group.continent}`}>
          {hubs.has(group.continent) ? (
            <a href={paths.continent(group.continent)}>{CONTINENT_LABELS[group.continent]}</a>
          ) : (
            CONTINENT_LABELS[group.continent]
          )}
        </h2>
        <div class="boxes">
          {group.countries.map((country, i) => (
            <CountryBox country={country} lazy={index > 0 || i > 3} />
          ))}
        </div>
      </section>
    ))}

    <p class="note">
      New countries are added once at least 15 of their outlets are verified.{' '}
      <a href="/methodology/">Read how we verify outlets</a>.
    </p>
  </div>
</BaseLayout>

<script>
  // Switches every country box to the chosen topic; ?topic= keeps the choice on reload and share.
  const bar = document.querySelector<HTMLElement>('[data-topics]');
  if (bar) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button[data-topic]')];
    const show = (topic: string) => {
      if (!buttons.some((b) => b.dataset.topic === topic)) topic = 'all';
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.topic === topic));
      for (const box of document.querySelectorAll<HTMLElement>('.box[data-topics]')) {
        const covered = box.dataset.topics?.split(' ').includes(topic) ?? false;
        box.hidden = !covered;
        for (const list of box.querySelectorAll<HTMLElement>('.list[data-topic]'))
          list.hidden = list.dataset.topic !== topic;
      }
      for (const section of document.querySelectorAll<HTMLElement>('[data-continent]'))
        section.hidden = !section.querySelector('.box:not([hidden])');
      const url = new URL(location.href);
      if (topic === 'all') url.searchParams.delete('topic');
      else url.searchParams.set('topic', topic);
      history.replaceState(null, '', url);
    };
    bar.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-topic]');
      if (button?.dataset.topic) show(button.dataset.topic);
    });
    const initial = new URLSearchParams(location.search).get('topic');
    if (initial) show(initial);
  }
</script>

<style>
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .topics button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard);
    color: var(--ink);
    font: inherit;
    font-size: var(--type-data);
    font-weight: 700;
    cursor: pointer;
    transition:
      transform var(--duration-press) var(--ease-out),
      box-shadow var(--duration-press) var(--ease-out);
  }

  .topics button:hover {
    background: var(--surface-hover);
  }

  /* The chosen topic stays pressed in, filled with the action color. */
  .topics button[aria-pressed='true'] {
    background: var(--accent);
    box-shadow: 0 0 0 var(--shadow-ink);
    color: var(--on-accent);
    transform: translate(3px, 3px);
  }

  .topics button[aria-pressed='true'] .data {
    color: inherit;
  }

  .topics .data {
    color: var(--ink-2);
    font-weight: normal;
  }

  /* On phones the topics stay on one line that scrolls, so the boxes start higher up. */
  @media (max-width: 639px) {
    .topics {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--space-4));
      padding-inline: var(--space-4);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .topics button {
      flex: 0 0 auto;
    }
  }

  .continent[hidden] {
    display: none;
  }

  .intro {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
    padding-block: var(--space-7) var(--space-6);
  }

  .intro h1 {
    font-size: var(--type-display);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 40rem;
    font-size: 1.1875rem;
  }

  .find {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: min(100%, 30rem);
    min-height: 3rem;
    padding-inline: var(--space-4);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard-lg);
    color: var(--ink-2);
    font: inherit;
    cursor: pointer;
  }

  .find:active {
    box-shadow: 0 0 0 var(--shadow-ink);
    transform: translate(5px, 5px);
  }

  .find span {
    flex: 1;
    text-align: start;
  }

  .find:hover {
    background: var(--surface-hover);
    color: var(--ink);
  }

  kbd {
    padding: 0 var(--space-1);
    border: 1px solid var(--rule-strong);
    font-family: var(--font-data);
    font-size: var(--type-label);
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    font-weight: var(--weight-strong);
  }

  .jump .data {
    color: var(--ink-2);
    font-weight: normal;
  }

  .continent {
    margin-top: var(--space-6);
  }

  .boxes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-5);
  }

  .continent h2 {
    scroll-margin-top: var(--space-4);
    margin-bottom: var(--space-3);
    font-size: var(--type-h2);
  }

  .continent h2 a {
    color: var(--ink);
  }

  .note {
    margin-top: var(--space-7);
    color: var(--ink-2);
    font-size: var(--type-data);
  }
</style>
