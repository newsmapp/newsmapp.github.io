---
import BaseLayout from '../layouts/BaseLayout.astro';
import Turnstile from '../components/Turnstile.astro';
import SponsoredSlot from '../components/SponsoredSlot.astro';
import Faq from '../components/Faq.astro';
import { CATEGORIES } from '../schemas/catalog.schema';
import { categoryLabel, countries, countryByIso, countryName, outletsFor } from '../data/catalog';
import { pricing } from '../data/monetization';
import { formatUsd, priceRows, tierFor, yearlySavingMonths } from '../lib/monetization/pricing';

const sorted = [...countries].sort((a, b) => countryName(a).localeCompare(countryName(b), 'en'));
// A real column from the directory shows where a listing appears.
const example = sorted.find((c) => outletsFor(c, 'general-news').length >= 3) ?? sorted[0];
const exampleRows = example ? outletsFor(example, 'general-news').slice(0, 3) : [];
const prices = Object.fromEntries(
  sorted.map((c) => {
    const tier = tierFor(pricing, c.iso2);
    return [c.iso2, { monthly: tier.monthly, yearly: tier.yearly }];
  }),
);
const rows = priceRows(pricing, (iso) => {
  const country = countryByIso(iso);
  return country && countryName(country);
});
// Only prices someone can actually pay today: tiers that cover a listed country.
const lowest = Math.min(...rows.map((r) => r.tier.monthly));
const faq = [
  {
    q: 'Does sponsoring change our position in the ranking?',
    a: 'No. Sponsored places sit above the editorial ranking, on a highlighted background, labeled Sponsored. Your organic position, if you have one, does not move.',
  },
  {
    q: 'Who can buy a listing?',
    a: 'News outlets, broadcasters and journalism projects that publish original reporting. An editor reviews every purchase before it goes live, and refunds it in full if we decline it.',
  },
  {
    q: 'How long until the listing is live?',
    a: 'After the editor approves it, usually within one business day. The site updates a few minutes after approval.',
  },
  {
    q: 'What do we get besides the placement?',
    a: 'A monthly report of filtered clicks on your listing. Figures are estimates: automated traffic and repeated clicks are removed, and some browsers block counting.',
  },
  {
    q: 'Can we cancel?',
    a: 'Yes, at any time. The listing stays until the end of the period you paid for. Payment and invoices are handled by LemonSqueezy as merchant of record, so tax is included where it applies.',
  },
];
---

<BaseLayout
  turnstile
  title="Sponsor your outlet's category"
  description={`Place your outlet above the ranking in its country and category, labeled Sponsored, from ${formatUsd(lowest)} a month. Three places per category, reviewed by an editor.`}
>
  <div class="page">
    <section class="hero" aria-labelledby="hero">
      <div class="pitch">
        <h1 id="hero">Be the first outlet readers see in your category</h1>
        <p class="lede">
          Three sponsored places sit above each country's ranking, labeled Sponsored and kept apart
          from it. From {formatUsd(lowest)} a month, reviewed by an editor, cancel anytime.
        </p>
        <form
          class="check"
          aria-label="Check availability and price"
          data-slot-check
          data-prices={JSON.stringify(prices)}
        >
          <label class="field">
            <span>Country</span>
            <select name="country" required>
              {sorted.map((c) => (
                <option value={c.iso2}>{countryName(c)}</option>
              ))}
            </select>
          </label>
          <label class="field">
            <span>Category</span>
            <select name="category" required>
              {CATEGORIES.map((c) => (
                <option value={c}>{categoryLabel(c)}</option>
              ))}
            </select>
          </label>
          <p class="availability" role="status" aria-live="polite" data-availability>
            Choose a country and category to see open places and the price.
          </p>
        </form>
      </div>

      {example && (
        <figure class="preview">
          <div class="column">
            <p class="column-head">
              {categoryLabel('general-news')}, {countryName(example)}
            </p>
            <ol>
              <SponsoredSlot
                sponsorship={{
                  id: 'example',
                  name: 'Your outlet',
                  url: 'https://your-outlet.example/',
                  icon: null,
                }}
              />
            </ol>
            <ol class="ranked">
              {exampleRows.map((o, i) => (
                <li>
                  <span class="rank data">{i + 1}</span>
                  <img src={o.icon} alt="" width="20" height="20" />
                  <span class="name">{o.name}</span>
                </li>
              ))}
            </ol>
          </div>
          <figcaption>
            Your listing goes in the highlighted place. The ranking below it does not change.
          </figcaption>
        </figure>
      )}
    </section>

    <section class="prices" aria-labelledby="prices">
      <h2 id="prices">Price by country</h2>
      <p class="model">One place, one category, one country. Monthly or yearly.</p>
      <table>
        <thead>
          <tr>
            <th scope="col">Countries</th>
            <th scope="col">Monthly</th>
            <th scope="col">Yearly</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ tier, label }) => (
            <tr>
              <td>{label}</td>
              <td class="num">{formatUsd(tier.monthly)}</td>
              <td class="num">
                {formatUsd(tier.yearly)}{' '}
                <span class="save">({yearlySavingMonths(tier)} months free)</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="buy" aria-labelledby="buy">
      <h2 id="buy">Reserve a place</h2>
      <p class="model">
        The place is held for 30 minutes while you pay. If an editor declines the listing, you get a
        full refund.
      </p>
      <form class="form" data-api-form data-endpoint="/api/checkout/" novalidate>
        <div class="pair">
          <label class="field">
            <span>Country</span>
            <select name="country_iso" required data-sync="country">
              {sorted.map((c) => (
                <option value={c.iso2}>{countryName(c)}</option>
              ))}
            </select>
            <span class="field-error" data-field-error="country_iso"></span>
          </label>
          <label class="field">
            <span>Category</span>
            <select name="category" required data-sync="category">
              {CATEGORIES.map((c) => (
                <option value={c}>{categoryLabel(c)}</option>
              ))}
            </select>
            <span class="field-error" data-field-error="category"></span>
          </label>
        </div>
        <fieldset class="field plans">
          <legend>Plan</legend>
          <label>
            <input type="radio" name="plan" value="monthly" checked /> Monthly{' '}
            <span data-price="monthly"></span>
          </label>
          <label>
            <input type="radio" name="plan" value="yearly" /> Yearly{' '}
            <span data-price="yearly"></span>
          </label>
        </fieldset>
        <label class="field">
          <span>Outlet name</span>
          <input name="outlet_name" required maxlength="120" autocomplete="organization" />
          <span class="field-error" data-field-error="outlet_name"></span>
        </label>
        <label class="field">
          <span>Website</span>
          <input
            name="url"
            type="url"
            required
            inputmode="url"
            spellcheck="false"
            placeholder="https://…"
          />
          <span class="field-error" data-field-error="url"></span>
        </label>
        <label class="field">
          <span>Billing e-mail</span>
          <input
            name="contact_email"
            type="email"
            required
            autocomplete="email"
            spellcheck="false"
            placeholder="you@example.com"
          />
          <span class="field-error" data-field-error="contact_email"></span>
        </label>
        <Turnstile />
        <button class="submit" type="submit" data-busy="Reserving…">
          Reserve and go to payment
        </button>
        <p class="form-status" role="status" data-form-status></p>
      </form>
    </section>

    <Faq items={faq} heading="What outlets ask before sponsoring" />

    <p class="closing">
      Readers already compare outlets by topic here. A sponsored place puts yours first, honestly
      labeled. <a href="#buy">Reserve a place</a>
    </p>
  </div>
</BaseLayout>

<script>
  import '../scripts/forms';
  import { initSlotCheck } from '../scripts/slots';
  initSlotCheck();
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }

  .pitch {
    display: grid;
    gap: var(--space-4);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .lede {
    max-width: 52ch;
    color: var(--ink-2);
    font-size: 1.125rem;
  }

  .check {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: 34rem;
    padding: var(--space-4);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard-lg);
  }

  .availability {
    grid-column: 1 / -1;
    min-height: 3em;
    font-weight: var(--weight-strong);
  }

  .preview {
    display: grid;
    gap: var(--space-3);
  }

  .column {
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard-lg);
    overflow: hidden;
  }

  .column-head {
    padding: var(--space-3);
    font-weight: var(--weight-strong);
  }

  .ranked {
    border-top: var(--line) solid var(--edge);
  }

  .ranked li {
    display: grid;
    grid-template-columns: 1.75rem 20px minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    min-height: var(--row-height);
    padding-inline: var(--space-2);
    border-top: 1px solid var(--rule);
    font-size: var(--type-data);
    font-weight: var(--weight-strong);
  }

  .ranked li:first-child {
    border-top: 0;
  }

  .rank {
    color: var(--ink-2);
    text-align: right;
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  figcaption {
    color: var(--ink-2);
    font-size: var(--type-data);
  }

  .prices,
  .buy {
    margin-top: var(--space-7);
  }

  h2 {
    margin-bottom: var(--space-2);
  }

  .model {
    margin-bottom: var(--space-4);
    color: var(--ink-2);
  }

  table {
    width: 100%;
    max-width: 48rem;
    border-collapse: collapse;
    font-size: var(--type-data);
  }

  th,
  td {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
    text-align: start;
    vertical-align: top;
  }

  th {
    color: var(--ink-2);
    font-weight: var(--weight-strong);
  }

  .num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .save {
    color: var(--ink-2);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .plans {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    border: 0;
  }

  .plans legend {
    margin-bottom: var(--space-1);
    font-size: var(--type-data);
    font-weight: var(--weight-strong);
  }

  .plans label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
  }

  .closing {
    max-width: 60ch;
    margin-top: var(--space-7);
    font-size: 1.125rem;
  }

  .closing a {
    font-weight: var(--weight-strong);
  }

  :global(.faq-wrap),
  .page > :global(section[aria-labelledby='faq']) {
    margin-top: var(--space-7);
  }
</style>
