---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CountryList from '../../../components/CountryList.astro';
import { CONTINENT_LABELS, countriesIn, hubContinents, paths } from '../../../data/catalog';
import type { Continent } from '../../../schemas/common';
import { plural } from '../../../lib/format';
import { breadcrumbList } from '../../../lib/seo/jsonld';

export function getStaticPaths() {
  return hubContinents.map((continent) => ({ params: { continent }, props: { continent } }));
}

interface Props {
  continent: Continent;
}

const { continent } = Astro.props;
const label = CONTINENT_LABELS[continent];
const list = countriesIn(continent);
const outlets = list.reduce((n, c) => n + c.outlets.length, 0);
const siteUrl = (Astro.site ?? new URL('https://newsmap.example')).toString();
const crumbs = [
  { label: 'Home', href: paths.home },
  { label, href: paths.continent(continent) },
];
---

<BaseLayout
  title={`News sources in ${label}: ${list.length} countries`}
  description={`Newspapers, broadcasters and news sites from ${list.length} countries in ${label}, ${outlets} outlets ranked by category with paywall and ownership.`}
  jsonld={[breadcrumbList(siteUrl, crumbs)]}
  searchable
  searchType="continent"
>
  <div class="page">
    <div class="intro">
      <Breadcrumbs items={crumbs} />
      <h1>News sources in {label}</h1>
      <p class="lede">
        {plural(outlets, 'outlet')} from {plural(list.length, 'country', 'countries')}. Countries
        that span two continents are listed in both.
      </p>
    </div>
    <CountryList countries={list} />
  </div>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5) var(--space-5);
  }

  .lede {
    color: var(--ink-2);
  }
</style>
