---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CategoryColumnCard from '../../../components/CategoryColumnCard.astro';
import AffiliateCard from '../../../components/AffiliateCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import PressFreedom from '../../../components/PressFreedom.astro';
import Faq from '../../../components/Faq.astro';
import CountryList from '../../../components/CountryList.astro';
import FilterBar from '../../../components/FilterBar';
import type { PublicCountry } from '../../../lib/catalog/public';
import {
  categoryLabel,
  categoryPages,
  countries,
  countryPlace,
  hubs,
  relatedCountries,
} from '../../../data/catalog';
import { forEachLang, i18n } from '../../../data/i18n';
import { affiliates, sponsorshipsFor } from '../../../data/monetization';
import { countryGrid } from '../../../lib/catalog/thresholds';
import { selectAffiliate } from '../../../lib/monetization/affiliates';
import { formatCompact } from '../../../lib/format';
import type { Lang } from '../../../lib/i18n/lang';
import { breadcrumbList, faqPage, itemList } from '../../../lib/seo/jsonld';
import { FORMATS, OWNERSHIP_TYPES, PAYWALLS } from '../../../schemas/catalog.schema';

export const getStaticPaths = () =>
  forEachLang(() =>
    countries.map((country) => ({ params: { country: country.slug }, props: { country } })),
  );

interface Props {
  country: PublicCountry;
  lang: Lang;
}

const { country, lang } = Astro.props;
const { t, l, paths } = i18n(Astro.url);
const where = countryPlace(country, lang);
const name = where.name;
const context = country.seo_context[lang];
const grid = countryGrid(country.outlets);
const withPages = new Set(categoryPages(country, lang));
const related = relatedCountries(country);
const siteUrl = (Astro.site ?? new URL('https://newsmap.example')).toString();
const affiliate = selectAffiliate(affiliates, {
  kind: 'country',
  paywalls: country.outlets.map((o) => o.paywall),
});

const crumbs = [
  { label: t.crumbs.home, href: paths.home },
  ...(hubs.has(country.continent)
    ? [{ label: l.continent[country.continent], href: paths.continent(country.continent) }]
    : []),
  { label: name, href: paths.country(country) },
];

const present = <T extends string>(
  values: readonly T[],
  pick: (o: PublicCountry['outlets'][number]) => T,
) => values.filter((value) => country.outlets.some((o) => pick(o) === value));

const total = country.outlets.length;
const title = t.country.title(where, total);
const description = t.country.description(where, total);
const jsonld = [
  breadcrumbList(siteUrl, crumbs),
  itemList(
    t.country.itemList(where),
    country.outlets.map((o) => ({
      name: o.name,
      url: new URL(paths.outlet(country, o), siteUrl).toString(),
    })),
  ),
  ...(context ? [faqPage(context.faq)] : []),
];
---

<BaseLayout title={title} description={description} jsonld={jsonld} searchable searchType="country">
  <div class="page">
    <div class="intro">
      <Breadcrumbs items={crumbs} />
      <h1>
        <img class="flag" src={paths.flag(country.iso2)} alt="" width="32" height="24" />
        {t.country.heading(where)}
      </h1>
      <p class="lede">
        {t.country.lede(total, grid.columns.length)}{' '}
        <a href={paths.page('/methodology/')}>{t.country.howWeRank}</a>
      </p>
    </div>

    <nav class="tabs" aria-label={t.country.tabs}>
      {grid.columns.map(({ category }) => (
        <a href={`#${category}`}>{categoryLabel(category, lang)}</a>
      ))}
      {grid.more.length > 0 && <a href="#more-outlets">{t.column.more}</a>}
    </nav>

    <div class="filterbar">
      <FilterBar
        client:load
        total={total}
        labels={t.filter}
        paywalls={present(PAYWALLS, (o) => o.paywall).map((v) => ({
          value: v,
          label: l.paywallTag[v],
        }))}
        ownership={present(OWNERSHIP_TYPES, (o) => o.ownership_type).map((v) => ({
          value: v,
          label: l.ownership[v],
        }))}
        formats={present(FORMATS, (o) => o.format).map((v) => ({
          value: v,
          label: l.format[v],
        }))}
      />
    </div>

    <div class="grid">
      {grid.columns.map(({ category, outlets }, index) => (
        <CategoryColumnCard
          country={country}
          category={category}
          outlets={outlets}
          sponsorships={sponsorshipsFor(country.iso2, category)}
          hasPage={withPages.has(category)}
          aboveFold={index < 4}
        />
      ))}
      {grid.more[0] && (
        <CategoryColumnCard
          country={country}
          category={grid.more[0].primary_category}
          outlets={grid.more}
          hasPage={false}
          moreLabel={t.column.more}
        />
      )}
    </div>

    <AdSlot placement="leaderboard" />

    <div class="below">
      <div class="reading">
        {context && (
          <section aria-labelledby="landscape">
            <h2 id="landscape">{t.country.landscape(where)}</h2>
            <div class="prose">
              {context.summary.split(/\n\n+/).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </section>
        )}
        {context && context.faq.length > 0 && (
          <Faq items={context.faq} heading={t.country.faq(where)} />
        )}
      </div>
      <aside class="side">
        {affiliate && <AffiliateCard affiliate={affiliate} pageCountry={country.iso2} />}
        <PressFreedom country={country} where={where} />
        <section aria-labelledby="facts">
          <h2 id="facts">{t.country.about(where)}</h2>
          <dl class="facts data">
            <dt>{t.country.population}</dt>
            <dd>
              {formatCompact(country.population.value, lang)} ({country.population.year},{' '}
              <a href={country.population.source} rel="noopener">
                {t.country.worldBank}
              </a>
              )
            </dd>
            <dt>{t.country.continent}</dt>
            <dd>{l.continent[country.continent]}</dd>
          </dl>
        </section>
        {related.length > 0 && (
          <section aria-labelledby="nearby">
            <h2 id="nearby">{t.country.nearby}</h2>
            <CountryList countries={related} />
          </section>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5) var(--space-4);
  }

  .flag {
    display: inline-block;
    margin-inline-end: var(--space-2);
    border: 1px solid var(--edge);
    vertical-align: -0.08em;
  }

  @media (max-width: 639px) {
    h1 {
      font-size: 1.75rem;
    }

    .flag {
      width: 26px;
      height: 19.5px;
    }
  }

  .lede {
    color: var(--ink-2);
  }

  .lede a {
    margin-inline-start: var(--space-1);
  }

  .tabs {
    display: none;
  }

  .filterbar {
    padding-block: var(--space-3);
    border-block: var(--line) solid var(--edge);
    margin-bottom: var(--space-5);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    align-items: start;
    gap: var(--space-4);
  }

  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .tabs {
      position: sticky;
      top: 3.5rem;
      z-index: var(--z-sticky);
      display: flex;
      gap: var(--space-4);
      margin-inline: calc(var(--space-4) * -1);
      padding: var(--space-2) var(--space-4);
      overflow-x: auto;
      border-bottom: 1px solid var(--rule);
      background: var(--canvas);
      font-size: var(--type-data);
      font-weight: var(--weight-strong);
      white-space: nowrap;
      scrollbar-width: none;
    }

    .tabs a {
      color: var(--ink-2);
      text-decoration: none;
    }

    .tabs a:hover {
      color: var(--link);
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }

  .below {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  @media (min-width: 1024px) {
    .below {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }
  }

  .reading {
    display: grid;
    gap: var(--space-7);
    align-content: start;
  }

  .reading h2 {
    margin-bottom: var(--space-3);
  }

  .side {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .side h2 {
    margin-bottom: var(--space-2);
    font-size: var(--type-h3);
  }

  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-1) var(--space-3);
  }

  .facts dt {
    color: var(--ink-2);
  }
</style>
