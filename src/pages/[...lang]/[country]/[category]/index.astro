---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CategoryColumnCard from '../../../../components/CategoryColumnCard.astro';
import type { PublicCountry } from '../../../../lib/catalog/public';
import type { Category } from '../../../../schemas/catalog.schema';
import {
  categoryLabel,
  categoryPages,
  countries,
  countriesIn,
  countryName,
  countryPlace,
  hubs,
  outletsFor,
} from '../../../../data/catalog';
import { forEachLang, i18n, siteLangs } from '../../../../data/i18n';
import { localizePath, type Lang } from '../../../../lib/i18n/lang';
import { breadcrumbList, itemList } from '../../../../lib/seo/jsonld';

export const getStaticPaths = () =>
  forEachLang((lang) =>
    countries.flatMap((country) =>
      categoryPages(country, lang).map((category) => ({
        params: { country: country.slug, category },
        props: { country, category },
      })),
    ),
  );

interface Props {
  country: PublicCountry;
  category: Category;
  lang: Lang;
}

const { country, category, lang } = Astro.props;
const { t, l, paths } = i18n(Astro.url);
const where = countryPlace(country, lang);
const name = where.name;
const label = categoryLabel(category, lang);
const outlets = outletsFor(country, category);
const intro = country.seo_context[lang]?.categories[category]?.intro ?? '';
// A category page is built per language (it needs that language's intro): where it is missing,
// hreflang leaves it out and the language switch leads to the country page instead.
const langs = siteLangs.filter((l) => categoryPages(country, l).includes(category));
const switchTo = Object.fromEntries(
  siteLangs.filter((l) => !langs.includes(l)).map((l) => [l, localizePath(`/${country.slug}/`, l)]),
);
const siteUrl = (Astro.site ?? new URL('https://newsmapp.github.io')).toString();
// The same category in other countries of the continent, for internal linking.
const elsewhere = countriesIn(country.continent)
  .filter((c) => c.iso2 !== country.iso2 && categoryPages(c, lang).includes(category))
  .slice(0, 8);
const crumbs = [
  { label: t.crumbs.home, href: paths.home },
  ...(hubs.has(country.continent)
    ? [{ label: l.continent[country.continent], href: paths.continent(country.continent) }]
    : []),
  { label: name, href: paths.country(country) },
  { label, href: paths.category(country, category) },
];
---

<BaseLayout
  langs={langs}
  switchTo={switchTo}
  title={t.category.titles(label, where, outlets.length)}
  description={t.category.description(label, where, outlets.length)}
  jsonld={[
    breadcrumbList(siteUrl, crumbs),
    itemList(
      t.category.heading(label, where),
      outlets.map((o) => ({
        name: o.name,
        url: new URL(paths.outlet(country, o), siteUrl).toString(),
      })),
    ),
  ]}
  searchable
  searchType="category"
>
  <div class="page">
    <div class="intro">
      <Breadcrumbs items={crumbs} />
      <h1>{t.category.heading(label, where)}</h1>
      <p class="prose">{intro}</p>
    </div>

    <div class="layout">
      <div class="main">
        <div class="table-wrap">
          <table>
            <caption class="visually-hidden">{t.category.caption(label, where)}</caption>
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">{t.category.outlet}</th>
                <th scope="col">{t.category.founded}</th>
                <th scope="col">{t.category.owner}</th>
                <th scope="col">{t.category.access}</th>
                <th scope="col">{t.category.ownership}</th>
                <th scope="col">RSS</th>
              </tr>
            </thead>
            <tbody>
              {outlets.map((outlet, index) => (
                <tr>
                  <td class="num">{index + 1}</td>
                  <th scope="row">
                    <a href={paths.outlet(country, outlet)}>{outlet.name}</a>
                  </th>
                  <td class="num">{outlet.founded_year ?? t.category.unknown}</td>
                  <td>{outlet.owner ?? t.category.unknown}</td>
                  <td>{l.paywallTag[outlet.paywall]}</td>
                  <td>{l.ownership[outlet.ownership_type]}</td>
                  <td>
                    {outlet.rss_url ? (
                      <a href={outlet.rss_url} rel="noopener">
                        {t.category.feed}
                      </a>
                    ) : (
                      t.category.none
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <aside class="side">
        <CategoryColumnCard
          country={country}
          category={category}
          outlets={outlets}
          hasPage={false}
          visible={outlets.length}
        />
        {elsewhere.length > 0 && (
          <section aria-labelledby="elsewhere">
            <h2 id="elsewhere">{t.category.elsewhere(label, l.continent[country.continent])}</h2>
            <ul class="links">
              {elsewhere.map((c) => (
                <li>
                  <a href={paths.category(c, category)}>{countryName(c, lang)}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <p class="back">
          <a href={paths.country(country)}>{t.category.back(where)}</a>
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-6);
  }

  .layout {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }
  }

  .main {
    min-width: 0;
  }

  .table-wrap {
    overflow-x: auto;
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard-lg);
  }

  table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: var(--type-data);
  }

  th,
  td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--rule);
    text-align: start;
    vertical-align: top;
  }

  thead th {
    color: var(--ink-2);
    font-size: var(--type-label);
    font-weight: var(--weight-strong);
    white-space: nowrap;
  }

  tbody th {
    font-weight: var(--weight-strong);
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  .num {
    color: var(--ink-2);
    text-align: end;
    white-space: nowrap;
  }

  .side {
    display: grid;
    gap: var(--space-5);
  }

  .side h2 {
    margin-bottom: var(--space-2);
    font-size: var(--type-h3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
</style>
