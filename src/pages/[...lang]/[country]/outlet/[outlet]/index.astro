---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import AffiliateCard from '../../../../../components/AffiliateCard.astro';
import Icon from '../../../../../components/Icon.astro';
import type { PublicCountry, PublicOutlet } from '../../../../../lib/catalog/public';
import {
  categoryLabel,
  categoryPages,
  countries,
  countryPlace,
  hubs,
  isProfileIndexable,
  outletsFor,
  similarOutlets,
} from '../../../../../data/catalog';
import { forEachLang, i18n, siteLangs } from '../../../../../data/i18n';
import { LANG_META, type Lang } from '../../../../../lib/i18n/lang';
import { affiliates } from '../../../../../data/monetization';
import { selectAffiliate } from '../../../../../lib/monetization/affiliates';
import { BADGE_SIZE } from '../../../../../lib/badge';
import { displayHost } from '../../../../../lib/format';
import { breadcrumbList, newsMediaOrganization } from '../../../../../lib/seo/jsonld';

export const getStaticPaths = () =>
  forEachLang(() =>
    countries.flatMap((country) =>
      country.outlets.map((outlet) => ({
        params: { country: country.slug, outlet: outlet.slug },
        props: { country, outlet },
      })),
    ),
  );

interface Props {
  country: PublicCountry;
  outlet: PublicOutlet;
  lang: Lang;
}

const { country, outlet, lang } = Astro.props;
const { t, l, paths } = i18n(Astro.url);
const where = countryPlace(country, lang);
const name = where.name;
const pitch = outlet.pitch[lang] ?? outlet.pitch.en ?? '';
const siteUrl = (Astro.site ?? new URL('https://newsmap.example')).toString();
const indexable = isProfileIndexable(outlet, lang);
// Profiles exist in every language but are indexable only where their text is reviewed.
const langs = siteLangs.filter((l) => isProfileIndexable(outlet, l));
// Site search still lists every published outlet; only search engines skip thin profiles.
const about = outlet.about[lang];
const similar = similarOutlets(country, outlet);
const withPages = new Set(categoryPages(country, lang));
const affiliate = selectAffiliate(affiliates, {
  kind: 'outlet',
  category: outlet.primary_category,
  paywall: outlet.paywall,
});
const ranks = outlet.categories.map((category) => ({
  category,
  position: outletsFor(country, category).findIndex((o) => o.id === outlet.id) + 1,
}));
const primary = ranks.find((r) => r.category === outlet.primary_category) ?? ranks[0];
const ownerSourced = outlet.sources.some((s) => s.field === 'owner');
const crumbs = [
  { label: t.crumbs.home, href: paths.home },
  ...(hubs.has(country.continent)
    ? [{ label: l.continent[country.continent], href: paths.continent(country.continent) }]
    : []),
  { label: name, href: paths.country(country) },
  { label: outlet.name, href: paths.outlet(country, outlet) },
];
const profileUrl = new URL(paths.outlet(country, outlet), siteUrl).toString();
const badgeUrl = new URL(`/badge/${country.slug}/${outlet.slug}.svg`, siteUrl).toString();
const badgeSnippet = `<a href="${profileUrl}"><img src="${badgeUrl}" alt="NewsMapp" width="${BADGE_SIZE.width}" height="${BADGE_SIZE.height}"></a>`;
const description = t.outlet.description(
  outlet.name,
  pitch,
  l.paywallDescription[outlet.paywall],
  l.ownership[outlet.ownership_type],
);
const language =
  new Intl.DisplayNames([LANG_META[lang].intl], { type: 'language' }).of(outlet.language) ??
  outlet.language;
---

<BaseLayout
  title={t.outlet.titles(outlet.name, name)}
  description={description}
  noindex={!indexable}
  langs={langs}
  type="profile"
  jsonld={[
    breadcrumbList(siteUrl, crumbs),
    newsMediaOrganization({
      name: outlet.name,
      url: outlet.url,
      foundingYear: outlet.founded_year,
      parentOrganization: ownerSourced ? outlet.owner : null,
    }),
  ]}
  searchable
  searchType="outlet"
>
  <div class="page">
    <div class="intro">
      <Breadcrumbs items={crumbs} />
      <h1>
        <img class="favicon" src={outlet.icon} alt="" width="32" height="32" />
        <span translate="no">{outlet.name}</span>
      </h1>
      <p class="lede">{pitch}</p>
      <p class="actions">
        <a
          class="visit"
          href={outlet.url}
          rel="noopener"
          data-track={outlet.id}
          data-country={country.iso2}
          data-category={outlet.primary_category}
        >
          {t.outlet.visit(displayHost(outlet.url))}
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a href={paths.page(`/corrections/?outlet=${outlet.id}`)}>{t.outlet.correction}</a>
      </p>
    </div>

    <div class="layout">
      <div class="main">
        <section aria-labelledby="facts">
          <h2 id="facts">{t.outlet.facts}</h2>
          <dl class="facts">
            <dt>{t.outlet.country}</dt>
            <dd>
              <a href={paths.country(country)}>{name}</a>
            </dd>
            <dt>{t.outlet.rankedIn}</dt>
            <dd>
              <ul class="ranks">
                {ranks.map(({ category, position }) => (
                  <li>
                    {t.outlet.rankIn(position)}{' '}
                    {withPages.has(category) ? (
                      <a href={paths.category(country, category)}>
                        {categoryLabel(category, lang)}
                      </a>
                    ) : (
                      <a href={`${paths.country(country)}#${category}`}>
                        {categoryLabel(category, lang)}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </dd>
            <dt>{t.outlet.access}</dt>
            <dd>
              {l.paywallTag[outlet.paywall]}: {l.paywallDescription[outlet.paywall].toLowerCase()}
            </dd>
            <dt>{t.outlet.ownership}</dt>
            <dd>{l.ownership[outlet.ownership_type]}</dd>
            {outlet.owner && (
              <>
                <dt>{t.outlet.owner}</dt>
                <dd>{outlet.owner}</dd>
              </>
            )}
            {outlet.founded_year && (
              <>
                <dt>{t.outlet.founded}</dt>
                <dd class="num">{outlet.founded_year}</dd>
              </>
            )}
            <dt>{t.outlet.format}</dt>
            <dd>{l.format[outlet.format]}</dd>
            {outlet.region && (
              <>
                <dt>{t.outlet.region}</dt>
                <dd>{outlet.region}</dd>
              </>
            )}
            <dt>{t.outlet.language}</dt>
            <dd>{language}</dd>
            <dt>{t.outlet.rss}</dt>
            <dd>
              {outlet.rss_url ? (
                <a href={outlet.rss_url} rel="noopener">
                  {t.outlet.feed(displayHost(outlet.rss_url))}
                </a>
              ) : (
                t.outlet.noFeed
              )}
            </dd>
          </dl>
        </section>

        {about?.reviewed && (
          <section aria-labelledby="about">
            <h2 id="about">{t.outlet.about(outlet.name)}</h2>
            <p class="prose">{about.text}</p>
          </section>
        )}

        {outlet.sources.length > 0 && (
          <section aria-labelledby="sources">
            <h2 id="sources">{t.outlet.sources}</h2>
            <ul class="sources">
              {outlet.sources.map((source) => (
                <li>
                  <span class="field">{source.field.replace(/_/g, ' ')}</span>
                  <a href={source.url} rel="noopener">
                    {displayHost(source.url)}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section aria-labelledby="badge">
          <h2 id="badge">{t.outlet.badge(displayHost(outlet.url))}</h2>
          <p class="hint">
            {t.outlet.badgeHint(
              outlet.name,
              primary && primary.position > 0
                ? t.outlet.badgeRank(primary.position, categoryLabel(primary.category, lang))
                : '',
            )}
          </p>
          <img
            class="badge-preview"
            src={`/badge/${country.slug}/${outlet.slug}.svg`}
            alt="NewsMapp"
            width={BADGE_SIZE.width}
            height={BADGE_SIZE.height}
            loading="lazy"
          />
          <div class="snippet">
            <code id="badge-code">{badgeSnippet}</code>
            <button
              type="button"
              data-copy="badge-code"
              data-copied={t.outlet.copied}
              data-fallback={t.outlet.copyFallback}
            >
              {t.outlet.copy}
            </button>
          </div>
        </section>
      </div>

      <aside class="side">
        {similar.length > 0 && (
          <section aria-labelledby="similar">
            <h2 id="similar">{t.outlet.alternatives(where)}</h2>
            <ul class="similar">
              {similar.map((o) => (
                <li>
                  <img src={o.icon} alt="" width="20" height="20" loading="lazy" decoding="async" />
                  <a href={paths.outlet(country, o)}>{o.name}</a>
                  <span class="tag">{l.paywallTag[o.paywall]}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
        {affiliate && <AffiliateCard affiliate={affiliate} pageCountry={country.iso2} />}
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      const code = document.getElementById(button.dataset.copy ?? '');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.textContent = button.dataset.copied ?? '';
      } catch {
        getSelection()?.selectAllChildren(code);
        button.textContent = button.dataset.fallback ?? '';
      }
      setTimeout(() => (button.textContent = label), 2000);
    });
  });
</script>

<style>
  .intro {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-6);
  }

  h1 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    overflow-wrap: anywhere;
  }

  .favicon {
    flex: none;
    border-radius: var(--radius-card);
  }

  .lede {
    max-width: 60ch;
    color: var(--ink-2);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: var(--line) solid var(--edge);
    background: var(--accent);
    box-shadow: var(--shadow-hard);
    color: var(--on-accent);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .visit:hover {
    background: var(--surface-hover);
    color: var(--ink);
  }

  .visit:active {
    box-shadow: 0 0 0 var(--shadow-ink);
    transform: translate(3px, 3px);
  }

  .layout {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }
  }

  .main {
    display: grid;
    gap: var(--space-7);
  }

  h2 {
    margin-bottom: var(--space-3);
  }

  .side h2 {
    font-size: var(--type-h3);
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(7rem, max-content) 1fr;
    max-width: 44rem;
    font-size: var(--type-data);
  }

  .facts dt,
  .facts dd {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    color: var(--ink-2);
    font-weight: var(--weight-strong);
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .ranks {
    display: grid;
    gap: var(--space-1);
  }

  .sources {
    display: grid;
    gap: var(--space-2);
    font-size: var(--type-data);
  }

  .sources .field {
    display: inline-block;
    min-width: 9rem;
    color: var(--ink-2);
    text-transform: capitalize;
  }

  .hint {
    max-width: 60ch;
    color: var(--ink-2);
    font-size: var(--type-data);
  }

  .badge-preview {
    margin-block: var(--space-3);
  }

  .snippet {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2);
    align-items: start;
    max-width: 44rem;
  }

  .snippet code {
    padding: var(--space-3);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    font-family: var(--font-data);
    font-size: var(--type-label);
    overflow-wrap: anywhere;
  }

  .snippet button {
    min-height: 2.25rem;
    padding-inline: var(--space-3);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard);
    color: var(--link);
    font: inherit;
    font-size: var(--type-data);
    font-weight: var(--weight-strong);
    cursor: pointer;
  }

  .similar {
    border-top: var(--line) solid var(--edge);
  }

  .similar li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--row-height);
    border-bottom: 1px solid var(--rule);
    font-size: var(--type-data);
  }

  .similar a {
    overflow: hidden;
    font-weight: var(--weight-strong);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag {
    color: var(--ink-2);
    font-size: var(--type-label);
  }
</style>
