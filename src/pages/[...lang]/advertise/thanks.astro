---
import ProseLayout from '../../../layouts/ProseLayout.astro';
import { forEachLang, i18n } from '../../../data/i18n';

export const getStaticPaths = () => forEachLang(() => [{ params: {}, props: {} }]);

const { lang, paths } = i18n(Astro.url);
---

{lang === 'pt' ? (
  <ProseLayout
    title="Sua vaga está reservada"
    heading="Sua vaga está reservada"
    description="O que acontece depois que você paga por um destaque patrocinado no NewsMapp."
    noindex
  >
    <p>
      Obrigado. Um editor revisa cada destaque patrocinado, em geral em até um dia útil, e você
      recebe um e-mail quando ele estiver no ar. Se recusarmos, o pagamento é reembolsado
      integralmente.
    </p>
    <p data-simulated hidden>
      <strong>Modo de teste:</strong> nenhum pagamento foi cobrado. O checkout de patrocínio ainda
      não está ligado ao provedor de pagamentos.
    </p>
    <p>
      Dúvidas sobre o seu destaque? <a href={paths.page('/about/')}>Fale conosco</a>.
    </p>
  </ProseLayout>
) : (
  <ProseLayout
    title="Your place is reserved"
    heading="Your place is reserved"
    description="What happens after you pay for a sponsored listing on NewsMapp."
    noindex
  >
    <p>
      Thank you. An editor reviews every sponsored listing, usually within one business day, and you
      get an e-mail when it is live. If we decline it, the payment is refunded in full.
    </p>
    <p data-simulated hidden>
      <strong>Test mode:</strong> no payment was taken. Sponsorship checkout is not connected to the
      payment provider yet.
    </p>
    <p>
      Questions about your listing? <a href="/about/">Contact us</a>.
    </p>
  </ProseLayout>
)}

<script>
  if (new URLSearchParams(window.location.search).has('simulated')) {
    document.querySelector<HTMLElement>('[data-simulated]')?.removeAttribute('hidden');
  }
</script>
