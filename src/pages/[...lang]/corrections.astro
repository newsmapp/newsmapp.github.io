---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { forEachLang, i18n } from '../../data/i18n';
import { repoUrl } from '../../data/site';
import { issueFormUrl } from '../../lib/issues';
import site from '../../../data/site.json';

export const getStaticPaths = () => forEachLang(() => [{ params: {}, props: {} }]);

const { lang } = i18n(Astro.url);
const correction = issueFormUrl(repoUrl, 'correction');
const suggestion = issueFormUrl(repoUrl, 'suggestion');
const mail = `mailto:${site.contact_email}`;
const c = {
  en: {
    title: 'Report a correction or suggest an outlet',
    description:
      'Tell us about a wrong fact in a NewsMapp listing, or suggest a news outlet we should add. Every request is a public GitHub issue reviewed by an editor.',
    lede: 'NewsMapp is a static site with no servers or databases of its own, so requests go through GitHub, where the catalog lives. An editor reads every one, and accepted changes go live with the next update of the site.',
    fix: 'Fix a listing',
    fixBody:
      'Wrong website, paywall, owner, founding year or category, or an outlet that has closed: open a correction and include a source. The quickest way is the "Report a correction" link on the outlet\'s own page, which fills in the outlet for you.',
    fixCta: 'Open a correction',
    suggest: 'Suggest an outlet',
    suggestBody:
      'Tell us the outlet, its website, its country and the category it fits. The "Suggest an outlet" link under each category fills in the country and category for you.',
    suggestCta: 'Suggest an outlet',
    publicHeading: 'Before you send',
    publicBody:
      'Issues are public: anyone can read what you write and your GitHub username. Do not include personal data you would not want published.',
    noAccount: 'No GitHub account? Write to',
    noAccountAfter: 'and an editor will file the request for you.',
  },
  pt: {
    title: 'Envie uma correção ou sugira um veículo',
    description:
      'Avise sobre um dado errado em um item do NewsMapp ou sugira um veículo de notícias que devemos incluir. Cada pedido é uma issue pública no GitHub, analisada por um editor.',
    lede: 'O NewsMapp é um site estático, sem servidores nem banco de dados próprios, então os pedidos passam pelo GitHub, onde fica o catálogo. Um editor lê cada um, e as mudanças aceitas entram no ar com a próxima atualização do site.',
    fix: 'Corrigir um item',
    fixBody:
      'Site, paywall, dono, ano de fundação ou categoria errados, ou um veículo que fechou: abra uma correção e inclua uma fonte. O jeito mais rápido é o link "Enviar uma correção" na página do próprio veículo, que já preenche o veículo.',
    fixCta: 'Abrir uma correção',
    suggest: 'Sugerir um veículo',
    suggestBody:
      'Informe o veículo, o site, o país e a categoria em que ele se encaixa. O link "Sugira um veículo" abaixo de cada categoria já preenche o país e a categoria.',
    suggestCta: 'Sugerir um veículo',
    publicHeading: 'Antes de enviar',
    publicBody:
      'As issues são públicas: qualquer pessoa pode ler o que você escrever e o seu nome de usuário no GitHub. Não inclua dados pessoais que você não queira ver publicados.',
    noAccount: 'Não tem conta no GitHub? Escreva para',
    noAccountAfter: 'e um editor registra o pedido por você.',
  },
}[lang];
---

<BaseLayout title={c.title} description={c.description} searchable searchType="page">
  <div class="page doc">
    <h1>{c.title}</h1>
    <p class="lede">{c.lede}</p>

    <div class="cards">
      <section aria-labelledby="fix">
        <h2 id="fix">{c.fix}</h2>
        <p>{c.fixBody}</p>
        <p>
          <a class="button" href={correction}>
            {c.fixCta}
          </a>
        </p>
      </section>

      <section aria-labelledby="suggest">
        <h2 id="suggest">{c.suggest}</h2>
        <p>{c.suggestBody}</p>
        <p>
          <a class="button" href={suggestion}>
            {c.suggestCta}
          </a>
        </p>
      </section>
    </div>

    <section class="note" aria-labelledby="before">
      <h2 id="before">{c.publicHeading}</h2>
      <p>{c.publicBody}</p>
      <p>
        {c.noAccount} <a href={mail}>{site.contact_email}</a>
        {c.noAccountAfter}
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .doc {
    padding-block: var(--space-6) var(--space-7);
  }

  .lede,
  .cards p,
  .note p {
    max-width: 60ch;
  }

  .lede {
    margin-top: var(--space-2);
    color: var(--ink-2);
  }

  .cards {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-6);
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  h2 {
    margin-bottom: var(--space-3);
  }

  .cards p + p {
    margin-top: var(--space-4);
  }

  .note {
    margin-top: var(--space-7);
    color: var(--ink-2);
  }

  .note p + p {
    margin-top: var(--space-2);
  }
</style>
