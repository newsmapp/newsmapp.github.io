---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountryBox from '../../components/CountryBox.astro';
import Icon from '../../components/Icon.astro';
import { countries, hubs, sortedCountries } from '../../data/catalog';
import { forEachLang, i18n } from '../../data/i18n';
import { CONTINENTS } from '../../schemas/common';
import { CATEGORIES } from '../../schemas/catalog.schema';
import { CATEGORY_ICON } from '../../lib/format';
import type { IconName } from '../../components/Icon.astro';
import { organization, website } from '../../lib/seo/jsonld';

export const getStaticPaths = () => forEachLang(() => [{ params: {}, props: {} }]);

const { lang, t, l, paths } = i18n(Astro.url);
const siteUrl = (Astro.site ?? new URL('https://newsmapp.github.io')).toString();
const outletCount = countries.reduce((n, c) => n + c.outlets.length, 0);
// Primary continent only, so transcontinental countries are listed once.
const sorted = sortedCountries(lang);
const groups = CONTINENTS.map((continent) => ({
  continent,
  countries: sorted.filter((c) => c.continent === continent),
})).filter((g) => g.countries.length > 0);
// Topics any published country covers, with how many outlets each has across the catalog.
const topics = CATEGORIES.map((category) => ({
  category,
  count: countries.reduce(
    (n, c) => n + c.outlets.filter((o) => o.categories.includes(category)).length,
    0,
  ),
})).filter((t) => t.count > 0);
const description =
  countries.length > 0
    ? t.home.description(outletCount, countries.length)
    : t.home.emptyDescription;
---

<BaseLayout
  title={t.home.title}
  description={description}
  jsonld={[website(siteUrl), organization(siteUrl)]}
  prose={false}
>
  <div class="page">
    <section class="intro">
      <h1>{t.home.heading}</h1>
      <p class="lede">
        {countries.length > 0 ? t.home.lede(outletCount, countries.length) : t.home.empty}
      </p>
      <button class="find" type="button" data-open-search>
        <Icon name="search" size={18} />
        <span>{t.home.find}</span>
        <kbd class="data">⌘&nbsp;K</kbd>
      </button>
      {topics.length > 1 && (
        <div class="topics" role="group" aria-label={t.home.topics} data-topics>
          <button type="button" aria-pressed="true" data-topic="all">
            <Icon name="list" size={16} />
            {t.home.allTopics}
          </button>
          {topics.map((topic) => (
            <button type="button" aria-pressed="false" data-topic={topic.category}>
              <Icon name={CATEGORY_ICON[topic.category] as IconName} size={16} />
              {l.categoryShort[topic.category]}
              <span class="data">{topic.count}</span>
            </button>
          ))}
        </div>
      )}
      {groups.length > 1 && (
        <nav class="jump" aria-label={t.home.continents}>
          <ul>
            {groups.map((group) => (
              <li>
                <a href={`#c-${group.continent}`}>
                  {l.continent[group.continent]}
                  <span class="data">{group.countries.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </section>

    {groups.map((group, index) => (
      <section
        class="continent"
        data-continent={group.continent}
        aria-labelledby={`c-${group.continent}`}
      >
        <div class="continent-head">
          <h2 id={`c-${group.continent}`}>
            {hubs.has(group.continent) ? (
              <a href={paths.continent(group.continent)}>{l.continent[group.continent]}</a>
            ) : (
              l.continent[group.continent]
            )}
          </h2>
          {/* Shown by the script: without it every continent stays open. */}
          <button
            class="fold"
            type="button"
            aria-expanded="true"
            aria-controls={`boxes-${group.continent}`}
            data-collapse
            data-hide={t.home.hide}
            data-show={t.home.show}
            hidden
          >
            <Icon name="chevron-down" size={16} />
            <span data-collapse-label>{t.home.hide}</span>
            <span class="data">{t.countries(group.countries.length)}</span>
            <span class="visually-hidden">{t.home.inContinent(l.continent[group.continent])}</span>
          </button>
        </div>
        <div class="boxes" id={`boxes-${group.continent}`}>
          {group.countries.map((country, i) => (
            <CountryBox country={country} lazy={index > 0 || i > 3} />
          ))}
        </div>
      </section>
    ))}

    <p class="note">
      {t.home.note} <a href={paths.page('/methodology/')}>{t.home.noteLink}</a>.
    </p>
  </div>
</BaseLayout>

<script>
  // Switches every country box to the chosen topic; ?topic= keeps the choice on reload and share.
  const bar = document.querySelector<HTMLElement>('[data-topics]');
  if (bar) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button[data-topic]')];
    const show = (topic: string) => {
      if (!buttons.some((b) => b.dataset.topic === topic)) topic = 'all';
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.topic === topic));
      for (const box of document.querySelectorAll<HTMLElement>('.box[data-topics]')) {
        const covered = box.dataset.topics?.split(' ').includes(topic) ?? false;
        box.hidden = !covered;
        for (const list of box.querySelectorAll<HTMLElement>('.list[data-topic]'))
          list.hidden = list.dataset.topic !== topic;
      }
      for (const section of document.querySelectorAll<HTMLElement>('[data-continent]'))
        section.hidden = !section.querySelector('.box:not([hidden])');
      const url = new URL(location.href);
      if (topic === 'all') url.searchParams.delete('topic');
      else url.searchParams.set('topic', topic);
      history.replaceState(null, '', url);
    };
    bar.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-topic]');
      if (button?.dataset.topic) show(button.dataset.topic);
    });
    const initial = new URLSearchParams(location.search).get('topic');
    if (initial) show(initial);
  }

  // Collapses a continent's boxes so the others come closer; the choice is kept per browser.
  const KEY = 'collapsed-continents';
  const remembered = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? '[]') as string[];
    } catch {
      return [];
    }
  };
  const collapsed = new Set(remembered());
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('button[data-collapse]')];
  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    const boxes = document.getElementById(button.getAttribute('aria-controls') ?? '');
    const label = button.querySelector('[data-collapse-label]');
    if (boxes) boxes.hidden = !open;
    if (label) label.textContent = (open ? button.dataset.hide : button.dataset.show) ?? '';
    button.setAttribute('aria-expanded', String(open));
  };
  const save = () => {
    try {
      localStorage.setItem(KEY, JSON.stringify([...collapsed]));
    } catch {
      // Storage blocked: the choice lasts until the page is left.
    }
  };
  for (const button of toggles) {
    const continent = button.closest<HTMLElement>('[data-continent]')?.dataset.continent ?? '';
    button.hidden = false;
    setOpen(button, !collapsed.has(continent));
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      setOpen(button, open);
      if (open) collapsed.delete(continent);
      else collapsed.add(continent);
      save();
    });
  }
  // A jump link to a collapsed continent opens it.
  document.querySelector('.jump')?.addEventListener('click', (event) => {
    const href = (event.target as Element).closest('a')?.getAttribute('href') ?? '';
    const section = document.getElementById(href.slice(1))?.closest('[data-continent]');
    const button = section?.querySelector<HTMLButtonElement>('button[data-collapse]');
    if (button?.getAttribute('aria-expanded') === 'false') button.click();
  });
</script>

<style>
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .topics button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard);
    color: var(--ink);
    font: inherit;
    font-size: var(--type-data);
    font-weight: 700;
    cursor: pointer;
    transition:
      transform var(--duration-press) var(--ease-out),
      box-shadow var(--duration-press) var(--ease-out);
  }

  .topics button:hover {
    background: var(--surface-hover);
  }

  /* The chosen topic stays pressed in, filled with the action color. */
  .topics button[aria-pressed='true'] {
    background: var(--accent);
    box-shadow: 0 0 0 var(--shadow-ink);
    color: var(--on-accent);
    transform: translate(3px, 3px);
  }

  .topics button[aria-pressed='true'] .data {
    color: inherit;
  }

  .topics .data {
    color: var(--ink-2);
    font-weight: normal;
  }

  /* On phones the topics stay on one line that scrolls, so the boxes start higher up. */
  @media (max-width: 639px) {
    .topics {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--space-4));
      padding-inline: var(--space-4);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .topics button {
      flex: 0 0 auto;
    }
  }

  .continent[hidden] {
    display: none;
  }

  .intro {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
    padding-block: var(--space-7) var(--space-6);
  }

  .intro h1 {
    font-size: var(--type-display);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 40rem;
    font-size: 1.1875rem;
  }

  .find {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: min(100%, 30rem);
    min-height: 3rem;
    padding-inline: var(--space-4);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard-lg);
    color: var(--ink-2);
    font: inherit;
    cursor: pointer;
  }

  .find:active {
    box-shadow: 0 0 0 var(--shadow-ink);
    transform: translate(5px, 5px);
  }

  .find span {
    flex: 1;
    text-align: start;
  }

  .find:hover {
    background: var(--surface-hover);
    color: var(--ink);
  }

  kbd {
    padding: 0 var(--space-1);
    border: 1px solid var(--rule-strong);
    font-family: var(--font-data);
    font-size: var(--type-label);
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    font-weight: var(--weight-strong);
  }

  .jump .data {
    color: var(--ink-2);
    font-weight: normal;
  }

  .continent {
    margin-top: var(--space-6);
  }

  .boxes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-5);
  }

  .continent-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-3);
  }

  .continent h2 {
    scroll-margin-top: var(--space-4);
    font-size: var(--type-h2);
  }

  .fold {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard);
    color: var(--ink);
    font: inherit;
    font-size: var(--type-data);
    font-weight: 700;
    cursor: pointer;
    transition:
      transform var(--duration-press) var(--ease-out),
      box-shadow var(--duration-press) var(--ease-out);
  }

  .fold[hidden] {
    display: none;
  }

  .fold:hover {
    background: var(--surface-hover);
  }

  .fold:active {
    box-shadow: 0 0 0 var(--shadow-ink);
    transform: translate(3px, 3px);
  }

  .fold .data {
    color: var(--ink-2);
    font-weight: normal;
  }

  /* The chevron points right while the continent is collapsed. */
  .fold :global(.icon) {
    transition: transform var(--duration-press) var(--ease-out);
  }

  .fold[aria-expanded='false'] :global(.icon) {
    transform: rotate(-90deg);
  }

  .boxes[hidden] {
    display: none;
  }

  .continent h2 a {
    color: var(--ink);
  }

  .note {
    margin-top: var(--space-7);
    color: var(--ink-2);
    font-size: var(--type-data);
  }
</style>
