---
import '../styles/global.css';
// Preloaded so the Latin faces arrive before first paint; a late font swap shifts the layout (CLS).
import uiFont from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import proseFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette';
import { buildMeta } from '../lib/seo/meta';
import { hreflangAlternates } from '../lib/seo/hreflang';
import { serializeJsonLd } from '../lib/seo/jsonld';
import { LANG_META, stripLang, type Lang } from '../lib/i18n/lang';
import { i18n, siteLangs } from '../data/i18n';

interface Props {
  title: string | readonly string[];
  description: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
  jsonld?: Record<string, unknown>[];
  /** Pagefind indexing: only indexable directory pages are searchable. */
  searchable?: boolean;
  searchType?: 'country' | 'category' | 'outlet' | 'continent' | 'page';
  /** Pages with a Turnstile form allow its script and frame in the CSP. */
  turnstile?: boolean;
  /** False on pages without serif text, so its font does not compete with the first paint. */
  prose?: boolean;
  /** Languages in which this page is indexable, for hreflang. Defaults to every site language. */
  langs?: readonly Lang[];
  /** Header language switch targets for languages without this page (see Header). */
  switchTo?: Partial<Record<Lang, string>> | false;
}

const {
  title,
  description,
  noindex = false,
  type,
  jsonld = [],
  searchable = false,
  searchType,
  turnstile = false,
  prose = true,
  langs = siteLangs,
  switchTo,
} = Astro.props;
// CSP additions must happen here: the <meta> is already sent by the time body components render.
if (turnstile) {
  Astro.csp?.insertScriptResource('https://challenges.cloudflare.com');
  Astro.csp?.insertDirective('frame-src https://challenges.cloudflare.com');
}
const { lang, t, paths } = i18n(Astro.url);
const siteUrl = (Astro.site ?? new URL('https://newsmap.example')).toString();
const meta = buildMeta({
  title,
  description,
  path: Astro.url.pathname,
  siteUrl,
  noindex,
  locale: LANG_META[lang].og,
  ...(type ? { type } : {}),
});
// Alternates only between languages where the page is indexable, so every link is reciprocal;
// noindex pages carry none.
const alternates =
  noindex || !langs.includes(lang)
    ? []
    : hreflangAlternates(stripLang(Astro.url.pathname), langs, siteUrl);
---

<!doctype html>
<html lang={LANG_META[lang].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={meta.robots} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {Object.entries(meta.og).map(([property, content]) => (
      <meta property={property} content={content} />
    ))}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="oklch(0.975 0.004 95)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
    {prose && <link rel="preload" href={proseFont} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (function () {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Storage blocked: fall back to the system preference.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        if (theme === 'dark') {
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute('content', 'oklch(0.205 0.012 250)');
        }
      })();
    </script>
    {jsonld.map((data) => (
      <script type="application/ld+json" is:inline set:html={serializeJsonLd(data)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <Header
      search={Astro.url.pathname !== paths.home}
      {...(switchTo !== undefined ? { switchTo } : {})}
    />
    <main id="main" tabindex="-1" {...(searchable ? { 'data-pagefind-body': '' } : {})}>
      {searchType && <meta data-pagefind-filter="type[content]" content={searchType} />}
      <slot />
    </main>
    <Footer />
    <CommandPalette client:idle labels={t.palette} />
    <script>
      import '../scripts/track';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: var(--z-dialog);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-card);
    background: var(--link);
    color: var(--on-link);
    font-weight: var(--weight-strong);
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
