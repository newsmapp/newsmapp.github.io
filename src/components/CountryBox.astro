---
import type { PublicCountry, PublicOutlet } from '../lib/catalog/public';
import { CATEGORIES, type Category } from '../schemas/catalog.schema';
import { categoryPages, countryName, outletsFor, paths } from '../data/catalog';
import { CATEGORY_SHORT, PAYWALL_DESCRIPTION, PAYWALL_TAG, plural } from '../lib/format';

interface Props {
  country: PublicCountry;
  /** Outlets listed before the link to the country page. */
  visible?: number;
  /** Icons load at low priority either way, so the fonts and the intro text come first. */
  lazy?: boolean;
}

const { country, visible = 5, lazy = true } = Astro.props;
const name = countryName(country);
// The editors' national ranking leads; other outlets fill the box in rank order.
const national = outletsFor(country, 'general-news');
const top: PublicOutlet[] = [
  ...national,
  ...country.outlets.filter((o) => !national.includes(o)),
].slice(0, visible);
const pages = categoryPages(country);
// One list per topic the country covers; the home page topic switcher shows one at a time.
const lists: { topic: Category | 'all'; outlets: PublicOutlet[]; total: number; href: string }[] = [
  { topic: 'all', outlets: top, total: country.outlets.length, href: paths.country(country) },
  ...CATEGORIES.map((category) => {
    const outlets = outletsFor(country, category);
    return {
      topic: category,
      outlets: outlets.slice(0, visible),
      total: outlets.length,
      href: pages.includes(category)
        ? paths.category(country, category)
        : `${paths.country(country)}#${category}`,
    };
  }).filter((list) => list.total > 0),
];
const headingId = `box-${country.iso2.toLowerCase()}`;
---

<section
  class="box"
  aria-labelledby={headingId}
  data-topics={lists.map((list) => list.topic).join(' ')}
>
  <h3 id={headingId} class="head">
    <a href={paths.country(country)}>
      <img
        src={paths.flag(country.iso2)}
        alt=""
        width="24"
        height="18"
        loading={lazy ? 'lazy' : 'eager'}
        fetchpriority="low"
        decoding="async"
      />
      <span class="name">{name}</span>
    </a>
  </h3>
  {lists.map((list) => (
    <div class="list" data-topic={list.topic} hidden={list.topic !== 'all'}>
      <ol class="outlets">
        {list.outlets.map((outlet) => (
          <li>
            <img
              class="favicon"
              src={outlet.icon}
              alt=""
              width="20"
              height="20"
              loading={lazy || list.topic !== 'all' ? 'lazy' : 'eager'}
              fetchpriority="low"
              decoding="async"
            />
            <a
              href={outlet.url}
              rel="noopener"
              translate="no"
              title={outlet.name}
              data-track={outlet.id}
              data-country={country.iso2}
              data-category={list.topic === 'all' ? outlet.primary_category : list.topic}
            >
              {outlet.name}
            </a>
            <span
              class:list={['tag', outlet.paywall === 'free' ? 'tag-free' : 'tag-paid']}
              title={PAYWALL_DESCRIPTION[outlet.paywall]}
            >
              {PAYWALL_TAG[outlet.paywall]}
            </span>
          </li>
        ))}
      </ol>
      <a class="all" href={list.href}>
        See all {plural(list.total, 'outlet')}
        <span class="visually-hidden">
          {list.topic === 'all' ? '' : `for ${CATEGORY_SHORT[list.topic]} `}in {name}
        </span>
      </a>
    </div>
  ))}
</section>

<style>
  .box {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard-lg);
  }

  .head {
    border-bottom: var(--line) solid var(--edge);
    font-size: var(--type-body);
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .head a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    color: var(--ink);
    text-decoration: none;
  }

  .head a:hover .name {
    color: var(--link);
    text-decoration: underline;
  }

  .head img {
    border: 1px solid var(--edge);
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .box[hidden] {
    display: none;
  }

  .list {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .list[hidden] {
    display: none;
  }

  .outlets li {
    display: grid;
    grid-template-columns: var(--icon-size) minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-2);
    min-height: var(--row-height);
    padding-inline: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .outlets li:hover {
    background: var(--surface-hover);
  }

  .favicon {
    border-radius: var(--radius-tag);
    background: var(--canvas);
  }

  .outlets a {
    overflow: hidden;
    color: var(--ink);
    font-size: var(--type-data);
    font-weight: var(--weight-strong);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The whole row is the target on touch screens; the tag stays readable on top. */
  .outlets a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .outlets li {
    position: relative;
  }

  .outlets a:hover,
  .outlets a:focus-visible {
    color: var(--link);
    text-decoration: underline;
  }

  .tag {
    padding: 1px 5px;
    border: 1px solid currentColor;
    font-family: var(--font-data);
    text-transform: uppercase;
    font-size: var(--type-label);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .tag-free {
    color: var(--tag-free);
  }

  .tag-paid {
    color: var(--tag-paid);
  }

  .all {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: auto;
    padding-inline: var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: var(--type-data);
  }
</style>
