---
import { TURNSTILE_SITE_KEY } from 'astro:env/client';

// The widget script is the only third-party script on the site, loaded only on form pages.
// The page's BaseLayout needs `turnstile` so the CSP allows it.
---

<div
  class="cf-turnstile"
  data-sitekey={TURNSTILE_SITE_KEY}
  data-theme="auto"
  data-size="flexible"
></div>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .cf-turnstile {
    min-height: 65px;
  }
</style>
