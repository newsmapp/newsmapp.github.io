---
import type { Affiliate } from '../lib/monetization/affiliates';
import { isVpnOffer } from '../lib/monetization/affiliates';
import { i18n } from '../data/i18n';

interface Props {
  affiliate: Affiliate;
  /** ISO2 of the page's country: the VPN offer is hidden for visitors from that country. */
  pageCountry?: string;
}

const { affiliate, pageCountry } = Astro.props;
const { lang, t, paths } = i18n(Astro.url);
const copy = affiliate.translations?.[lang] ?? affiliate;
---

<aside
  class="affiliate"
  aria-label={t.affiliate.label}
  data-affiliate
  data-vpn={isVpnOffer(affiliate) ? '' : undefined}
  data-page-country={pageCountry}
>
  <p class="headline">{copy.headline}</p>
  <p class="body">{copy.body}</p>
  <p class="actions">
    <a class="cta" href={paths.go(`aff-${affiliate.id}`)} rel="sponsored noopener">
      {copy.cta}
    </a>
    <span class="disclosure">
      {t.affiliate.disclosure} <a href={paths.page('/disclosures/')}>{t.affiliate.how}</a>
    </span>
  </p>
</aside>

<script>
  import { hideRestrictedOffers } from '../scripts/geo-offers';
  void hideRestrictedOffers();
</script>

<style>
  .affiliate {
    display: grid;
    gap: var(--space-2);
    min-height: 9.5rem;
    padding: var(--space-4);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard-lg);
  }

  .affiliate[data-hidden] {
    visibility: hidden;
  }

  .headline {
    font-weight: var(--weight-strong);
  }

  .body {
    max-width: 60ch;
    color: var(--ink-2);
    font-size: var(--type-data);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: var(--space-3);
    border: var(--line) solid var(--edge);
    background: var(--accent);
    box-shadow: var(--shadow-hard);
    color: var(--on-accent);
    font-size: var(--type-data);
    font-weight: 700;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--surface-hover);
    color: var(--ink);
  }

  .cta:active {
    box-shadow: 0 0 0 var(--shadow-ink);
    transform: translate(3px, 3px);
  }

  .disclosure {
    color: var(--ink-2);
    font-size: var(--type-label);
  }

  .disclosure a {
    color: inherit;
  }
</style>
