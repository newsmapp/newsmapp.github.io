---
import Icon from './Icon.astro';

interface Props {
  /** The home page has its own search button in the intro, so the header leaves it out. */
  search?: boolean;
}

const { search = true } = Astro.props;
---

<header class="site-header">
  <div class="page bar">
    <a class="wordmark" href="/" translate="no">
      News<span class="mapp">Mapp</span>
      <!-- "Mapp" is drawn: a map folded in three panels with a route to a pin. -->
      <svg class="fold" viewBox="0 0 36 24" aria-hidden="true" focusable="false">
        <path class="shade" d="M13 2 23 6v16l-10-4z" />
        <path class="outline" d="M2 6 13 2l10 4 11-4v16l-11 4-10-4-11 4zM13 2v16M23 6v16" />
        <path class="route" d="M6 17c3-5 6-7 10-5s8 1 12-4" />
        <circle class="pin" cx="28" cy="8" r="2.4" />
      </svg>
    </a>
    {search && (
      <button class="search" type="button" data-open-search aria-keyshortcuts="Meta+K Control+K">
        <Icon name="search" size={16} />
        <span class="search-label">Search countries and outlets</span>
        <kbd class="data">⌘&nbsp;K</kbd>
      </button>
    )}
    <nav aria-label="Site" class:list={['nav', { push: !search }]}>
      <a href="/advertise/">Advertise</a>
    </nav>
    <button class="theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
      <Icon name="moon" size={18} class="when-light" />
      <Icon name="sun" size={18} class="when-dark" />
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = (theme: string) => `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`;
  const root = document.documentElement;
  if (toggle) {
    toggle.setAttribute('aria-label', label(root.dataset.theme ?? 'light'));
    toggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be unavailable (private mode); the choice then lasts for this page only.
      }
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', getComputedStyle(root).getPropertyValue('--canvas').trim());
      toggle.setAttribute('aria-label', label(next));
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    border-bottom: 1px solid var(--rule);
    background: var(--canvas);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
  }

  .wordmark {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: var(--weight-heavy);
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  /* "Mapp" is read by assistive technology and drawn as the map below. */
  .mapp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Taller than the cap height so the folds and the route stay legible at header size. */
  .fold {
    width: 1.95em;
    height: 1.3em;
    overflow: visible;
  }

  .fold .outline {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .fold .shade {
    fill: currentColor;
    opacity: 0.12;
  }

  .fold .route {
    fill: none;
    stroke: var(--link);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-dasharray: 2.5 2.5;
  }

  .fold .pin {
    fill: var(--link);
  }

  .search {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-2);
    max-width: 26rem;
    min-height: 2.5rem;
    margin-inline-start: auto;
    padding-inline: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink-2);
    font: inherit;
    font-size: var(--type-data);
    cursor: pointer;
  }

  .search:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .search-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-align: start;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  kbd {
    padding: 0 var(--space-1);
    border: 1px solid var(--rule);
    border-radius: var(--radius-tag);
    font-family: inherit;
    font-size: var(--type-label);
  }

  .nav a {
    color: var(--ink);
    font-size: var(--type-data);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .theme {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--radius-card);
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }

  .theme:hover {
    background: var(--surface-hover);
    color: var(--ink);
  }

  :global([data-theme='dark']) .theme :global(.when-light),
  :global(:root:not([data-theme='dark'])) .theme :global(.when-dark) {
    display: none;
  }

  @media (max-width: 639px) {
    .search {
      flex: 0 0 auto;
      width: 2.5rem;
      padding: 0;
      justify-content: center;
    }

    kbd {
      display: none;
    }

    /* Hidden visually only: the label stays the button's accessible name. */
    .search-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
