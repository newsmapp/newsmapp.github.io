---
import Icon from './Icon.astro';
import { LANG_META, localizePath, stripLang, type Lang } from '../lib/i18n/lang';
import { i18n, siteLangs } from '../data/i18n';

interface Props {
  /** The home page has its own search button in the intro, so the header leaves it out. */
  search?: boolean;
  /**
   * Where the language switch leads, per language, when the same page does not exist there.
   * False hides the switch (English-only pages such as /admin/).
   */
  switchTo?: Partial<Record<Lang, string>> | false;
}

const { search = true, switchTo = {} } = Astro.props;
const { lang, t, paths } = i18n(Astro.url);
// The same page in the other site languages.
const switches =
  switchTo === false
    ? []
    : siteLangs
        .filter((l) => l !== lang)
        .map((l) => ({
          lang: l,
          href: switchTo[l] ?? localizePath(stripLang(Astro.url.pathname), l),
        }));
---

<header class="site-header">
  <div class="page bar">
    <a class="wordmark" href={paths.home} translate="no">
      <img class="mark" src="/mark.webp" alt="" width="32" height="32" />
      <span>
        News<span class="mapp">Mapp</span>
      </span>
    </a>
    {search && (
      <button class="search" type="button" data-open-search aria-keyshortcuts="Meta+K Control+K">
        <Icon name="search" size={16} />
        <span class="search-label">{t.header.search}</span>
        <kbd class="data">⌘&nbsp;K</kbd>
      </button>
    )}
    <nav aria-label={t.header.nav} class:list={['nav', { push: !search }]}>
      <a href={paths.page('/corrections/')}>{t.header.suggest}</a>
      {switches.map((s) => (
        <a
          class="lang"
          href={s.href}
          hreflang={LANG_META[s.lang].tag}
          lang={LANG_META[s.lang].tag}
          data-lang-switch
        >
          <Icon name="languages" size={16} />
          <span class="lang-name">{LANG_META[s.lang].name}</span>
          <span class="lang-code" aria-hidden="true">
            {s.lang.toUpperCase()}
          </span>
        </a>
      ))}
    </nav>
    <button
      class="theme"
      type="button"
      data-theme-toggle
      data-to-dark={t.header.toDark}
      data-to-light={t.header.toLight}
      aria-label={t.header.toDark}
    >
      <Icon name="moon" size={18} class="when-light" />
      <Icon name="sun" size={18} class="when-dark" />
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = (theme: string) =>
    (theme === 'dark' ? toggle?.dataset.toLight : toggle?.dataset.toDark) ?? '';
  const root = document.documentElement;
  if (toggle) {
    toggle.setAttribute('aria-label', label(root.dataset.theme ?? 'light'));
    toggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be unavailable (private mode); the choice then lasts for this page only.
      }
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', getComputedStyle(root).getPropertyValue('--canvas').trim());
      toggle.setAttribute('aria-label', label(next));
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    border-bottom: var(--line) solid var(--edge);
    /* Frosted so the graticule and the boxes stay faintly visible while scrolling under it. */
    background: color-mix(in oklch, var(--surface) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
  }

  .wordmark {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: var(--weight-heavy);
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  /* The brand symbol sits on its own white tile, so it reads the same in both themes. */
  .mark {
    width: 1.9em;
    height: 1.9em;
    margin-inline-end: 0.25em;
    border: var(--line) solid var(--edge);
  }

  .mapp {
    color: var(--link);
  }

  .search {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-2);
    max-width: 26rem;
    min-height: 2.5rem;
    margin-inline-start: auto;
    padding-inline: var(--space-3);
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard);
    color: var(--ink-2);
    font: inherit;
    font-size: var(--type-data);
    cursor: pointer;
  }

  .search:active,
  .theme:active {
    box-shadow: 0 0 0 var(--shadow-ink);
    transform: translate(3px, 3px);
  }

  .push {
    margin-inline-start: auto;
  }

  .search:hover {
    background: var(--surface-hover);
    color: var(--ink);
  }

  .search-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-align: start;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  kbd {
    padding: 0 var(--space-1);
    border: 1px solid var(--rule-strong);
    font-family: var(--font-data);
    font-size: var(--type-label);
  }

  .nav {
    display: flex;
    gap: var(--space-3);
  }

  .nav a {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    min-height: 2.5rem;
    color: var(--ink);
    font-size: var(--type-data);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .theme {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: var(--line) solid var(--edge);
    background: var(--surface);
    box-shadow: var(--shadow-hard);
    color: var(--ink);
    cursor: pointer;
  }

  .theme:hover {
    background: var(--surface-hover);
    color: var(--ink);
  }

  :global([data-theme='dark']) .theme :global(.when-light),
  :global(:root:not([data-theme='dark'])) .theme :global(.when-dark) {
    display: none;
  }

  .lang-code {
    display: none;
  }

  @media (max-width: 639px) {
    /* The full name stays the link's accessible name; the code is what fits. */
    .lang-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .lang-code {
      display: inline;
    }

    .search {
      flex: 0 0 auto;
      width: 2.5rem;
      padding: 0;
      justify-content: center;
    }

    kbd {
      display: none;
    }

    /* Hidden visually only: the label stays the button's accessible name. */
    .search-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
