---
import type { Category } from '../schemas/catalog.schema';
import type { PublicCountry, PublicOutlet } from '../lib/catalog/public';
import { categoryLabel, paths } from '../data/catalog';
import { CATEGORY_ICON } from '../lib/format';
import Icon, { type IconName } from './Icon.astro';
import OutletRow from './OutletRow.astro';
import SponsoredSlot, { type Sponsorship } from './SponsoredSlot.astro';

interface Props {
  country: PublicCountry;
  category: Category;
  outlets: PublicOutlet[];
  sponsorships?: Sponsorship[];
  hasPage: boolean;
  /** Rows shown before "Show all". */
  visible?: number;
  /** Whether this column is in the first row of the grid (eager icons). */
  aboveFold?: boolean;
  /** Replaces the category heading for the "More outlets" card. */
  moreLabel?: string;
}

const {
  country,
  category,
  outlets,
  sponsorships = [],
  hasPage,
  visible = 10,
  aboveFold = false,
  moreLabel,
} = Astro.props;
const label = moreLabel ?? categoryLabel(category);
const sectionId = moreLabel ? 'more-outlets' : category;
const headingId = `col-${sectionId}`;
const first = outlets.slice(0, visible);
const rest = outlets.slice(visible);
const lazyFrom = aboveFold ? 8 : 0;
---

<section class="column" id={sectionId} aria-labelledby={headingId} data-column>
  <header class="head">
    <Icon name={moreLabel ? 'list' : (CATEGORY_ICON[category] as IconName)} size={18} />
    <h2 id={headingId} class="title">
      {hasPage ? <a href={paths.category(country, category)}>{label}</a> : label}
    </h2>
    <span class="count data" data-count data-total={outlets.length}>
      {outlets.length}
    </span>
  </header>
  {sponsorships.length > 0 && (
    <ol class="sponsored-list" aria-label={`Sponsored listings in ${label}`}>
      {sponsorships.map((s) => (
        <SponsoredSlot sponsorship={s} />
      ))}
    </ol>
  )}
  <ol class="rows" aria-label={`${label}, ranked`}>
    {first.map((outlet, index) => (
      <OutletRow
        outlet={outlet}
        country={country}
        category={category}
        position={index + 1}
        lazy={index >= lazyFrom}
        ranked={!moreLabel}
      />
    ))}
  </ol>
  {rest.length > 0 && (
    <details class="more">
      <summary>Show all {outlets.length}</summary>
      <ol class="rows" start={visible + 1}>
        {rest.map((outlet, index) => (
          <OutletRow
            outlet={outlet}
            country={country}
            category={category}
            position={visible + index + 1}
            lazy
            ranked={!moreLabel}
          />
        ))}
      </ol>
    </details>
  )}
  <p class="empty" data-empty hidden>
    No outlets match these filters.
  </p>
  {!moreLabel && (
    <footer class="foot">
      <a href={`/corrections/?country=${country.iso2}&category=${category}`}>Suggest an outlet</a>
      <a href={`/advertise/?country=${country.iso2}&category=${category}`}>Feature yours</a>
    </footer>
  )}
</section>

<style>
  .column {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--surface);
    scroll-margin-top: var(--space-8);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-2);
    color: var(--ink-2);
  }

  .title {
    flex: 1;
    min-width: 0;
    color: var(--ink);
    font-size: var(--type-body);
    line-height: 1.3;
    letter-spacing: 0;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .count {
    color: var(--ink-2);
  }

  .sponsored-list {
    border-top: 1px solid var(--rule);
  }

  .sponsored-list + .rows {
    border-top: 2px solid var(--rule-strong);
  }

  .more summary {
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--rule);
    color: var(--link);
    font-size: var(--type-data);
    font-weight: var(--weight-strong);
    cursor: pointer;
  }

  .more[open] summary {
    display: none;
  }

  .empty {
    padding: var(--space-3);
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--type-data);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: auto;
    padding: var(--space-2) var(--space-3) var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: var(--type-label);
  }

  .foot a {
    color: var(--ink-2);
  }

  .foot a:hover {
    color: var(--link);
  }
</style>
