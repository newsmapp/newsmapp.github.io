---
import { displayHost } from '../lib/format';
import { i18n } from '../data/i18n';

export interface Sponsorship {
  id: string;
  name: string;
  url: string;
  icon: string | null;
}

interface Props {
  sponsorship: Sponsorship;
}

const { sponsorship } = Astro.props;
const { t, paths } = i18n(Astro.url);
---

<li class="sponsored" data-sponsored>
  <span class="label">{t.sponsored}</span>
  {sponsorship.icon ? (
    <img
      class="favicon"
      src={sponsorship.icon}
      alt=""
      width="20"
      height="20"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span class="favicon" aria-hidden="true" />
  )}
  <a
    class="name"
    href={paths.go(sponsorship.id)}
    rel="sponsored noopener"
    title={sponsorship.name}
    translate="no"
  >
    {sponsorship.name}
  </a>
  <span class="host data">{displayHost(sponsorship.url)}</span>
</li>

<style>
  .sponsored {
    display: grid;
    /* The name keeps its width; the host shrinks first and truncates. */
    grid-template-columns: auto var(--icon-size) minmax(0, max-content) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-2);
    min-height: var(--row-height);
    padding-inline: var(--space-2);
    background: var(--sponsor);
    color: var(--on-sponsor);
  }

  .sponsored + .sponsored {
    border-top: 1px solid color-mix(in oklch, var(--on-sponsor) 18%, transparent);
  }

  .label {
    font-size: var(--type-label);
    font-weight: var(--weight-strong);
  }

  .favicon {
    width: var(--icon-size);
    height: var(--icon-size);
    border-radius: var(--radius-tag);
  }

  .name {
    min-width: 0;
    overflow: hidden;
    color: inherit;
    font-size: var(--type-data);
    font-weight: var(--weight-strong);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .host {
    overflow: hidden;
    color: inherit;
    text-align: end;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.85;
    font-size: var(--type-label);
  }
</style>
