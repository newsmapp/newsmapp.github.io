---
import type { PublicCountry } from '../lib/catalog/public';
import type { Place } from '../lib/i18n/place';
import { i18n } from '../data/i18n';

interface Props {
  country: PublicCountry;
  where: Place;
}

const { country, where } = Astro.props;
const { t, l } = i18n(Astro.url);
const pf = country.press_freedom;
---

{pf && (
  <section class="press" aria-labelledby="press-freedom">
    <h2 id="press-freedom">{t.press.heading(where)}</h2>
    <dl class="data">
      <div>
        <dt>{t.press.rank}</dt>
        <dd>{t.press.rankValue(pf.rank, pf.year)}</dd>
      </div>
      <div>
        <dt>{t.press.situation}</dt>
        <dd>{l.pressFreedom[pf.status]}</dd>
      </div>
    </dl>
    <p class="source">
      {t.press.source}{' '}
      <a href={pf.source_url} rel="noopener">
        {pf.source}
      </a>
      {t.press.rsf}
    </p>
  </section>
)}

<style>
  .press {
    display: grid;
    gap: var(--space-3);
  }

  h2 {
    font-size: var(--type-h3);
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  dt {
    color: var(--ink-2);
    font-size: var(--type-label);
    font-weight: var(--weight-strong);
  }

  dd {
    font-size: var(--type-body);
    font-weight: var(--weight-strong);
  }

  .source {
    color: var(--ink-2);
    font-size: var(--type-label);
  }
</style>
