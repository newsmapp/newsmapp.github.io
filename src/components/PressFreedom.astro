---
import type { PublicCountry } from '../lib/catalog/public';

interface Props {
  country: PublicCountry;
  name: string;
}

const { country, name } = Astro.props;
const pf = country.press_freedom;
const STATUS: Record<string, string> = {
  good: 'Good',
  satisfactory: 'Satisfactory',
  problematic: 'Problematic',
  difficult: 'Difficult',
  'very-serious': 'Very serious',
};
---

{pf && (
  <section class="press" aria-labelledby="press-freedom">
    <h2 id="press-freedom">Press freedom in {name}</h2>
    <dl class="data">
      <div>
        <dt>Rank</dt>
        <dd>
          {pf.rank} of 180 ({pf.year})
        </dd>
      </div>
      <div>
        <dt>Situation</dt>
        <dd>{STATUS[pf.status]}</dd>
      </div>
    </dl>
    <p class="source">
      Source:{' '}
      <a href={pf.source_url} rel="noopener">
        {pf.source}
      </a>
      , Reporters Without Borders.
    </p>
  </section>
)}

<style>
  .press {
    display: grid;
    gap: var(--space-3);
  }

  h2 {
    font-size: var(--type-h3);
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  dt {
    color: var(--ink-2);
    font-size: var(--type-label);
    font-weight: var(--weight-strong);
  }

  dd {
    font-size: var(--type-body);
    font-weight: var(--weight-strong);
  }

  .source {
    color: var(--ink-2);
    font-size: var(--type-label);
  }
</style>
