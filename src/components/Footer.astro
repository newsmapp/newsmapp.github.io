---
import { i18n } from '../data/i18n';

const { t, paths } = i18n(Astro.url);
const year = new Date().getUTCFullYear();
const about = [
  ['/about/', t.footer.about],
  ['/methodology/', t.footer.methodology],
  ['/corrections/', t.footer.corrections],
  ['/advertise/', t.footer.advertise],
] as const;
const legal = [
  ['/disclosures/', t.footer.disclosures],
  ['/privacy/', t.footer.privacy],
  ['/terms/', t.footer.terms],
] as const;
---

<footer class="site-footer">
  <div class="page cols">
    <nav aria-label={t.footer.aboutNav}>
      <ul>
        {about.map(([path, label]) => (
          <li>
            <a href={paths.page(path)}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label={t.footer.legalNav}>
      <ul>
        {legal.map(([path, label]) => (
          <li>
            <a href={paths.page(path)}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="note">{t.footer.note(year)}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-block: var(--space-6) var(--space-7);
    border-top: var(--line) solid var(--edge);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--type-data);
  }

  .cols {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .cols {
      grid-template-columns: auto auto 1fr;
      column-gap: var(--space-7);
    }
  }

  ul {
    display: grid;
    gap: var(--space-2);
  }

  a {
    color: var(--ink-2);
  }

  a:hover {
    color: var(--link);
  }

  .note {
    max-width: 48ch;
  }
</style>
