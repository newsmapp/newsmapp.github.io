{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsmap",
  // Custom entry: Astro's fetch handler + the daily cron (src/worker.ts).
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://newsmap.example",
    "ENABLED_LOCALES": "en",
    "ADS_ENABLED": "false",
    "GITHUB_REPOSITORY": "owner/newsmap",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsmap",
      // Replace with the id printed by `wrangler d1 create newsmap` (see docs/runbooks/deploy.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "analytics_engine_datasets": [{ "binding": "CLICKS", "dataset": "newsmap_clicks" }],
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CLICK_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  "triggers": { "crons": ["0 3 * * *"] },
}
