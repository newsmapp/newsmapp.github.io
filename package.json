{
  "name": "newsmap",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist/client --glob \"**/*.html\" --output-subdir pagefind",
    "preview": "wrangler dev",
    "typecheck": "wrangler types && astro check && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint . && depcruise src tools --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "a11y": "playwright test --grep @a11y",
    "lhci": "lhci autorun",
    "seo:audit": "tsx tools/seo-audit.ts dist/client",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm catalog:validate && pnpm test",
    "fix": "prettier --write . && eslint . --fix",
    "catalog:validate": "tsx tools/catalog-cli/index.ts validate",
    "catalog:health": "tsx tools/catalog-cli/index.ts health",
    "catalog:draft": "tsx tools/catalog-cli/index.ts draft",
    "catalog:import": "tsx tools/catalog-cli/index.ts import",
    "catalog:add": "tsx tools/catalog-cli/index.ts add",
    "catalog:icons": "tsx tools/catalog-cli/index.ts icons",
    "catalog:report": "tsx tools/catalog-cli/index.ts report",
    "sponsorships:snapshot": "tsx tools/sponsorships-snapshot.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply newsmap --local",
    "db:migrate:remote": "wrangler d1 migrations apply newsmap --remote",
    "deploy": "pnpm build && wrangler deploy",
    "geo:generate": "tsx tools/generate-geo.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/preact": "^6.1.1",
    "astro": "^7.4.2",
    "drizzle-orm": "^0.45.4",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "countries-list": "^3.4.1",
    "dependency-cruiser": "^18.7.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^16.5.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
