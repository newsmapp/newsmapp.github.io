{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "worker-configuration.d.ts", "src", "tests"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  }
}
