# Local development: copy the secrets below into `.dev.vars` (read by wrangler/astro dev).
# Production: set each secret with `wrangler secret put <NAME>` (never commit real values).
# Non-secret configuration lives in wrangler.jsonc "vars".

# Public site URL used for canonicals and sitemaps (also set in wrangler.jsonc vars).
SITE_URL=https://newsmap.example

# HMAC secret for the daily-rotating visitor hash in click analytics. Any long random string.
VISITOR_HASH_SECRET=change-me

# Cloudflare Turnstile. The values below are Cloudflare's public always-pass test keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# LemonSqueezy. Leave empty to run checkout in simulation mode.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=local-webhook-secret

# Cloudflare Access (admin). Leave empty locally: admin then requires ADMIN_DEV_BYPASS=true.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ADMIN_DEV_BYPASS=true

# GitHub token allowed to dispatch the deploy workflow (rebuild after sponsorship changes).
GITHUB_DISPATCH_TOKEN=

# Build-time only (CI): read-only access to D1 for the sponsorship snapshot.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_READ_TOKEN=

# Admin click reports: token with Account Analytics Read, for the Analytics Engine SQL API.
CLOUDFLARE_ANALYTICS_TOKEN=
